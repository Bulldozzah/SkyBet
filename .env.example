# Copy to .env and fill in your Supabase project's values.
# skyBets shares the same Supabase project as betmaster, so the accounts,
# profiles (approval status) and saved bets are the same data.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# The Odds API — powers the Scanner. Free key from https://the-odds-api.com
# (500 credits/month; the Scanner shows remaining quota and per-scan cost).
#
# Deliberately NOT VITE_-prefixed. Vite inlines VITE_* into the browser bundle,
# and this is a paid credential: it is read only by lib/odds-server.ts, which
# never reaches the client. Set it as a secret in your deploy environment too.
ODDS_API_KEY=YOUR_ODDS_API_KEY
